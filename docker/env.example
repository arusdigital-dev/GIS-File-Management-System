# -----------------------------------------------------------------------------
# Docker defaults for GIS Report Management System
# Copy to docker/.env and adjust to match your compose stack.
# -----------------------------------------------------------------------------

# Application
APP_NAME="GIS Report System"
APP_ENV=production
APP_KEY= # generate inside the app container: php artisan key:generate
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres bootstrap (container)
POSTGRES_DB=gis_file
POSTGRES_USER=gis_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Laravel database connection (match the Postgres values above)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=${POSTGRES_PORT}
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# Sessions, queue, cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=
FILESYSTEM_DISK=local
MEMCACHED_HOST=127.0.0.1

# Redis (enable only if a redis service is present)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mailer (default to log; override if SMTP is available)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"
